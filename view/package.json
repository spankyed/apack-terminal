{
  "name": "@apackdev/terminal-view",
  "version": "0.2.0",
  "description": "Draws a terminal from rows something else interpreted: painting, scrolling, selection and input, with no terminal core of its own.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spankyed/apack-terminal.git",
    "directory": "view"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/rewrite-dts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.12"
  }
}
