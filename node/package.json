{
  "name": "@apackdev/terminal",
  "version": "0.2.0",
  "description": "The apack-terminal v2 broker: one sharded process that owns the PTYs, libghostty-vt core, segmented WAL recordings, and unified binary protocol.",
  "license": "MIT OR Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spankyed/apack-terminal.git",
    "directory": "node"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./wire-vectors-v2.json": "./wire-vectors-v2.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "wire-vectors-v2.json",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "optionalDependencies": {
    "@apackdev/terminal-darwin-arm64": "0.2.0",
    "@apackdev/terminal-linux-x64": "0.2.0",
    "@apackdev/terminal-win32-x64": "0.2.0"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "cargo xtask check-generated && node --test"
  },
  "publishConfig": {
    "access": "public"
  }
}
