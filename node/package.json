{
  "name": "@apackdev/terminal",
  "version": "0.1.0",
  "description": "The terminal broker: one process that owns the ptys, so a session's lifetime is not the lifetime of whatever asked for it.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spankyed/apack-terminal.git",
    "directory": "node"
  },
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./view-vectors.json": "./view-vectors.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.d.ts",
    "protocol.d.ts",
    "view-vectors.json",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "prepublishOnly": "cargo xtask check-generated"
  },
  "publishConfig": {
    "access": "public"
  }
}
