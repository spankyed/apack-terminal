{
  "name": "@apackdev/terminal",
  "version": "0.1.0",
  "description": "The terminal broker: one process that owns the ptys, so a session's lifetime is not the lifetime of whatever asked for it.",
  "license": "MIT OR Apache-2.0",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spankyed/apack-terminal.git",
    "directory": "node"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./view-vectors.json": "./view-vectors.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "protocol.d.ts",
    "view-vectors.json",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "optionalDependencies": {
    "@apackdev/terminal-darwin-arm64": "0.1.0",
    "@apackdev/terminal-linux-x64": "0.1.0",
    "@apackdev/terminal-win32-x64": "0.1.0"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "cargo xtask check-generated && node --test"
  },
  "publishConfig": {
    "access": "public"
  }
}
